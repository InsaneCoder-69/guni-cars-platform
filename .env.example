# GUNI CARS Platform - Environment Configuration

# Backend Server Port (Default: 5000)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# Client-side API Base URL (used when deploying frontend independently)
VITE_API_BASE_URL=http://localhost:5000/api

# Path to Google Chrome executable (optional, auto-detected on macOS / Linux)
# CHROME_BIN=/usr/bin/google-chrome
